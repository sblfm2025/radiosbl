rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserProfile() {
      return signedIn() && exists(userPath());
    }

    function currentUser() {
      return get(userPath()).data;
    }

    function isActiveUser() {
      return hasUserProfile() && currentUser().active == true;
    }

    function currentRole() {
      return isActiveUser() ? currentUser().role : 'public';
    }

    function isRole(roles) {
      return signedIn() && currentRole() in roles;
    }

    function isSuperAdmin() {
      return isRole(['super_admin']) || request.auth.token.email == 'sblfm2025@gmail.com' || request.auth.token.email == 'sablfm2025@gmail.com';
    }

    function isAdmin() {
      return isRole(['super_admin', 'admin']);
    }

    function isLeader() {
      return isRole(['super_admin', 'admin', 'leader']);
    }

    function canManageSchedule() {
      return isRole(['super_admin', 'admin']);
    }

    function canManageLiveOb() {
      return isRole(['super_admin', 'admin', 'leader', 'operator']);
    }

    function canAccessRadioBossOps() {
      return isRole(['super_admin', 'admin', 'operator']);
    }

    function canManageCoverage() {
      return isRole(['super_admin', 'admin', 'leader', 'reporter']);
    }

    function canManageComplaints() {
      return isRole(['super_admin', 'admin', 'leader']);
    }

    function canUseAi() {
      return isRole(['super_admin', 'admin', 'leader', 'announcer', 'reporter']);
    }

    function canReadAnalytics() {
      return isRole(['super_admin', 'admin', 'leader', 'operator']);
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function ownsAnnouncer(announcerId) {
      return isActiveUser()
        && (
          (('announcerId' in currentUser()) && currentUser().announcerId == announcerId)
          || (('employeeId' in currentUser()) && currentUser().employeeId == announcerId)
          || (('whatsapp' in currentUser()) && currentUser().whatsapp == announcerId)
          || (('whatsapp' in currentUser()) && ('wa-' + currentUser().whatsapp) == announcerId)
          || (('airName' in currentUser()) && currentUser().airName == announcerId)
          || (('announcerNames' in currentUser()) && currentUser().announcerNames is list && currentUser().announcerNames.hasAny([announcerId]))
        );
    }

    function hasAnnouncerAlias(aliases) {
      return isActiveUser()
        && aliases is list
        && (
          request.auth.uid in aliases
          || (('whatsapp' in currentUser()) && currentUser().whatsapp in aliases)
          || (('whatsapp' in currentUser()) && ('wa-' + currentUser().whatsapp) in aliases)
          || (('airName' in currentUser()) && currentUser().airName in aliases)
          || (('displayName' in currentUser()) && currentUser().displayName in aliases)
          || (('employeeId' in currentUser()) && currentUser().employeeId in aliases)
          || (('announcerNames' in currentUser()) && currentUser().announcerNames is list && currentUser().announcerNames.hasAny(aliases))
        );
    }

    function hasOnly(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function hasAll(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(fields);
    }

    function validStatus(value, statuses) {
      return value in statuses;
    }

    function validListenerAnalyticsSessionPayload() {
      return hasOnly([
        'id',
        'userId',
        'anonymousId',
        'startedAt',
        'lastSeenAt',
        'endedAt',
        'status',
        'source',
        'device',
        'program',
        'playback',
        'location',
        'privacy',
        'createdAt',
        'updatedAt'
      ])
      && hasAll([
        'id',
        'anonymousId',
        'startedAt',
        'lastSeenAt',
        'status',
        'source',
        'device',
        'playback',
        'location',
        'privacy',
        'createdAt',
        'updatedAt'
      ])
      && validStatus(request.resource.data.status, ['active', 'paused', 'ended', 'error'])
      && request.resource.data.source == 'web-pwa';
    }

    function validListenerStreamingErrorPayload() {
      return hasOnly([
        'sessionId',
        'event',
        'message',
        'programId',
        'programTitle',
        'deviceType',
        'browser',
        'os',
        'createdAt',
        'updatedAt'
      ])
      && hasAll(['event', 'createdAt'])
      && validStatus(request.resource.data.event, [
        'play_failed',
        'buffering_timeout',
        'stalled',
        'network_error',
        'media_error',
        'unknown'
      ]);
    }

    function validUserPayload() {
      return hasOnly([
        'email',
        'displayName',
        'airName',
        'announcerNames',
        'role',
        'employeeId',
        'announcerId',
        'photoUrl',
        'whatsapp',
        'active',
        'createdAt',
        'updatedAt'
      ])
      && hasAll(['email', 'displayName', 'role', 'active'])
      && validStatus(request.resource.data.role, [
        'super_admin',
        'admin',
        'leader',
        'announcer',
        'reporter',
        'operator',
        'employee',
        'public'
      ]);
    }

    function userEmailMatchesAuth() {
      return signedIn()
        && request.auth.token.email is string
        && request.resource.data.email == request.auth.token.email;
    }

    function staffProfilePath() {
      return /databases/$(database)/documents/users/$(('wa-' + request.resource.data.whatsapp));
    }

    function hasMatchingStaffProfile() {
      return request.resource.data.whatsapp is string
        && exists(staffProfilePath())
        && get(staffProfilePath()).data.role == request.resource.data.role
        && get(staffProfilePath()).data.active == true;
    }

    function isSelfPublicCreate(userId) {
      return isOwner(userId)
        && validUserPayload()
        && userEmailMatchesAuth()
        && request.resource.data.role == 'public'
        && request.resource.data.active == true;
    }

    function isSelfStaffClaim(userId) {
      return isOwner(userId)
        && validUserPayload()
        && userEmailMatchesAuth()
        && hasMatchingStaffProfile();
    }

    function isSelfProfileUpdate(userId) {
      return isOwner(userId)
        && validUserPayload()
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.active == resource.data.active
        && changedOnly([
          'displayName',
          'airName',
          'announcerNames',
          'employeeId',
          'announcerId',
          'photoUrl',
          'whatsapp',
          'updatedAt'
        ]);
    }

    function validAnnouncerPayload() {
      return hasOnly([
        'fullName',
        'airName',
        'scheduleNames',
        'photoUrl',
        'decreeOrder',
        'active',
        'totalDays',
        'totalHours',
        'note',
        'createdAt',
        'updatedAt'
      ])
      && hasAll(['fullName', 'airName', 'scheduleNames', 'decreeOrder', 'active']);
    }

    function validProgramPayload() {
      return hasOnly([
        'id',
        'title',
        'description',
        'defaultDurationMinutes',
        'category',
        'active',
        'createdAt',
        'updatedAt'
      ])
      && hasAll(['id', 'title', 'description', 'defaultDurationMinutes', 'active'])
      && (!('category' in request.resource.data)
        || request.resource.data.category in ['main', 'insert', 'playlist']);
    }

    function validSchedulePayload() {
      return hasOnly([
        'id',
        'programId',
        'announcerId',
        'announcerIds',
        'externalPic',
        'day',
        'timeLabel',
        'operatorId',
        'startsAt',
        'endsAt',
        'status',
        'createdAt',
        'updatedAt'
      ])
      && hasAll(['id', 'programId', 'startsAt', 'endsAt', 'status'])
      && validStatus(request.resource.data.status, [
        'draft',
        'ready',
        'live',
        'completed',
        'cancelled'
      ]);
    }

    function validCustomScheduleSlotPayload() {
      return hasOnly([
        'day',
        'time',
        'program',
        'description',
        'announcer',
        'sourceDay',
        'sourceTime',
        'createdAt',
        'updatedAt'
      ])
      && hasAll(['day', 'time', 'program', 'description', 'announcer', 'sourceDay', 'sourceTime']);
    }

    function validAttendancePayload() {
      return hasOnly([
        'userId',
        'displayName',
        'airName',
        'checkInAt',
        'checkOutAt',
        'clientTime',
        'latitude',
        'longitude',
        'accuracyMeters',
        'distanceToCenter',
        'userAgent',
        'confidenceScore',
        'aiVerificationText',
        'outOfOfficeReason',
        'selfieDriveFileId',
        'selfieUploadStatus',
        'selfieUploadError',
        'faceRecognitionUsed',
        'faceMatchDistance',
        'faceMatchStatus',
        'faceRecognitionMode',
        'faceRecognitionVersion',
        'faceRecognitionError',
        'faceEnrollmentStatus',
        'faceReferenceCount',
        'faceModelVersion',
        'faceSpoofCheckUsed',
        'faceSpoofCheckStatus',
        'faceMovementScore',
        'faceSpoofCheckError',
        'status',
        'createdAt',
        'updatedAt'
      ])
      && hasAll(['userId', 'checkInAt', 'latitude', 'longitude', 'selfieDriveFileId', 'status'])
      && (!('selfieUploadStatus' in request.resource.data)
        || validStatus(request.resource.data.selfieUploadStatus, ['pending', 'uploaded', 'failed']))
      && (!('faceMatchStatus' in request.resource.data)
        || validStatus(request.resource.data.faceMatchStatus, [
          'matched_candidate',
          'review_candidate',
          'mismatch_candidate',
          'not_enrolled',
          'disabled',
          'unavailable'
        ]))
      && (!('faceRecognitionMode' in request.resource.data)
        || validStatus(request.resource.data.faceRecognitionMode, ['observe_only', 'review']))
      && (!('faceEnrollmentStatus' in request.resource.data)
        || validStatus(request.resource.data.faceEnrollmentStatus, [
          'not_enrolled',
          'pending_review',
          'active',
          'needs_update',
          'disabled'
        ]))
      && (!('faceSpoofCheckStatus' in request.resource.data)
        || validStatus(request.resource.data.faceSpoofCheckStatus, ['passed', 'needs_review', 'unavailable']))
      && validStatus(request.resource.data.status, ['present', 'late', 'outside_radius', 'sick', 'leave', 'needs_review', 'rejected', 'valid']);
    }

    function validFaceProfilePayload() {
      return hasOnly([
        'enrolled',
        'status',
        'model',
        'modelVersion',
        'descriptorCount',
        'descriptors',
        'referenceDriveFileIds',
        'createdAt',
        'updatedAt',
        'approvedBy',
        'approvedAt'
      ])
      && hasAll(['enrolled', 'status', 'model', 'modelVersion', 'descriptorCount', 'descriptors'])
      && validStatus(request.resource.data.status, [
        'not_enrolled',
        'pending_review',
        'active',
        'needs_update',
        'disabled'
      ]);
    }

    function validSwapPayload() {
      return hasOnly([
        'scheduleId',
        'targetDate',
        'requesterId',
        'targetAnnouncerId',
        'requesterAliases',
        'targetAnnouncerAliases',
        'reason',
        'status',
        'createdAt',
        'updatedAt'
      ])
      && hasAll(['scheduleId', 'targetDate', 'requesterId', 'targetAnnouncerId', 'reason', 'status'])
      && request.resource.data.targetDate is string
      && validStatus(request.resource.data.status, [
        'pending_target',
        'approved',
        'rejected'
      ]);
    }

    function validScheduleOverridePayload() {
      return hasOnly([
        'date',
        'slotId',
        'type',
        'newProgram',
        'newAnnouncer',
        'newTime',
        'description',
        'reason',
        'sourceSwapId',
        'createdBy',
        'createdAt',
        'updatedAt'
      ])
      && hasAll(['date', 'slotId', 'type', 'reason', 'createdBy'])
      && validStatus(request.resource.data.type, [
        'replace',
        'add',
        'cancel',
        'reschedule',
        'activate_optional'
      ]);
    }

    function sourceSwapPath() {
      return /databases/$(database)/documents/schedule_swaps/$(request.resource.data.sourceSwapId);
    }

    function canCreateOverrideFromPendingSwap() {
      return signedIn()
        && request.resource.data.sourceSwapId is string
        && request.resource.data.createdBy == request.auth.uid
        && exists(sourceSwapPath())
        && (
          get(sourceSwapPath()).data.targetAnnouncerId == request.auth.uid
          || ownsAnnouncer(get(sourceSwapPath()).data.targetAnnouncerId)
          || hasAnnouncerAlias(get(sourceSwapPath()).data.targetAnnouncerAliases)
        )
        && get(sourceSwapPath()).data.status == 'pending_target'
        && (
          !('targetDate' in get(sourceSwapPath()).data)
          || request.resource.data.date == get(sourceSwapPath()).data.targetDate
        );
    }

    function validComplaintPayload() {
      return hasOnly([
        'reporterName',
        'category',
        'message',
        'status',
        'createdAt',
        'updatedAt'
      ])
      && hasAll(['reporterName', 'category', 'message', 'status'])
      && request.resource.data.category in [
        'Teknis',
        'Program',
        'Informasi Publik',
        'Lainnya'
      ]
      && request.resource.data.status in [
        'Baru',
        'Terverifikasi',
        'Diproses',
        'Selesai'
      ];
    }

    function validSongRequestPayload() {
      return hasOnly([
        'requesterName',
        'requesterWhatsapp',
        'requesterPhoneMasked',
        'artist',
        'title',
        'source',
        'channel',
        'reviewStatus',
        'rawMessage',
        'requestedTitle',
        'requestedArtist',
        'dedication',
        'whatsappMessageId',
        'message',
        'announcerName',
        'announcerWhatsapp',
        'status',
        'matchStatus',
        'matchedTrackId',
        'matchedFilePath',
        'confidence',
        'approvedBy',
        'approvedAt',
        'sentToRadioBossAt',
        'queuedAt',
        'playedAt',
        'rejectedBy',
        'rejectedAt',
        'rejectReason',
        'expiresAt',
        'createdAt',
        'updatedAt',
        'notificationText',
        'whatsappUrl'
      ])
      && hasAll(['requesterName', 'title', 'status', 'notificationText', 'createdAt'])
      && validStatus(request.resource.data.status, [
        'new',
        'notified',
        'pending_review',
        'matched',
        'needs_review',
        'sent_to_radioboss',
        'queued',
        'played',
        'rejected',
        'expired'
      ])
      && (!('matchStatus' in request.resource.data)
        || request.resource.data.matchStatus in ['unmatched', 'matched', 'ambiguous', 'not_found']);
    }

    function validProgramScriptDraftPayload() {
      return hasOnly([
        'programTitle',
        'scheduleTime',
        'day',
        'announcerName',
        'description',
        'provider',
        'tone',
        'durationMinutes',
        'intervention',
        'content',
        'status',
        'createdBy',
        'createdByName',
        'createdAt',
        'updatedAt'
      ])
      && hasAll([
        'programTitle',
        'scheduleTime',
        'day',
        'announcerName',
        'provider',
        'tone',
        'durationMinutes',
        'content',
        'status',
        'createdBy',
        'createdByName',
        'createdAt'
      ])
      && request.resource.data.provider in ['openai', 'gemini', 'demo']
      && validStatus(request.resource.data.status, ['draft', 'approved', 'used']);
    }

    function validDriveFilePayload() {
      return hasOnly([
        'driveFileId',
        'name',
        'mimeType',
        'size',
        'webViewLink',
        'module',
        'ownerId',
        'createdAt',
        'updatedAt'
      ])
      && hasAll(['driveFileId', 'name', 'mimeType', 'size', 'webViewLink', 'module', 'ownerId']);
    }

    function validLiveEventPayload() {
      return hasOnly([
        'title',
        'location',
        'startsAt',
        'youtubeUrl',
        'discordRoomUrl',
        'crewIds',
        'status',
        'createdAt',
        'updatedAt'
      ])
      && hasAll(['title', 'location', 'startsAt', 'crewIds', 'status'])
      && validStatus(request.resource.data.status, [
        'draft',
        'ready',
        'live',
        'completed'
      ]);
    }

    function validProgramRecordingRulePayload() {
      return hasOnly([
        'programId',
        'scheduleId',
        'programName',
        'recordingEnabled',
        'requireAttendance',
        'autoStart',
        'autoStop',
        'allowManualOverride',
        'startGraceMinutes',
        'stopGraceMinutes',
        'maxOverrunMinutes',
        'minDurationMinutes',
        'folderSlug',
        'format',
        'storageRootKey',
        'createdAt',
        'createdBy',
        'updatedAt',
        'updatedBy'
      ])
      && hasAll([
        'programId',
        'programName',
        'recordingEnabled',
        'requireAttendance',
        'autoStart',
        'autoStop',
        'allowManualOverride',
        'startGraceMinutes',
        'stopGraceMinutes',
        'maxOverrunMinutes',
        'minDurationMinutes',
        'folderSlug',
        'format',
        'storageRootKey'
      ])
      && (!('scheduleId' in request.resource.data) || request.resource.data.scheduleId is string)
      && request.resource.data.recordingEnabled is bool
      && request.resource.data.requireAttendance is bool
      && request.resource.data.autoStart is bool
      && request.resource.data.autoStop is bool
      && request.resource.data.allowManualOverride is bool
      && request.resource.data.format in ['mp3', 'wav'];
    }

    function validRadiobossCommandPayload() {
      return hasOnly([
        'type',
        'status',
        'payload',
        'requestedBy',
        'requestedByName',
        'requestedAt',
        'priority',
        'dedupeKey',
        'attempts',
        'maxAttempts',
        'lockedBy',
        'lockedAt',
        'executedAt',
        'gatewayId',
        'result',
        'errorCode',
        'errorMessageSafe',
        'createdAt',
        'updatedAt'
      ])
      && hasAll([
        'type',
        'status',
        'payload',
        'requestedBy',
        'requestedByName',
        'requestedAt',
        'priority',
        'dedupeKey',
        'attempts',
        'maxAttempts',
        'createdAt',
        'updatedAt'
      ])
      && request.resource.data.status == 'pending'
      && request.resource.data.type in [
        'START_RECORDING',
        'STOP_RECORDING',
        'MARK_RECORDING_SKIPPED',
        'RETRY_COMMAND',
        'ADD_TRACK_TO_QUEUE',
        'MARK_REQUEST_PLAYED'
      ]
      && request.resource.data.requestedBy == request.auth.uid
      && request.resource.data.payload is map
      && !('rawCommand' in request.resource.data)
      && !('rawCommand' in request.resource.data.payload)
      && request.resource.data.attempts == 0
      && request.resource.data.maxAttempts <= 3
      && request.resource.data.priority in ['low', 'normal', 'high'];
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if (isSuperAdmin() && !isOwner(userId)) || (signedIn() && userId.matches('^wa-.*'));

      match /faceProfiles/{profileId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isAdmin() && validFaceProfilePayload();
        allow delete: if isSuperAdmin();
      }
    }

    match /employees/{employeeId} {
      allow read: if isLeader() || isRole(['announcer', 'reporter', 'operator', 'employee']);
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /announcers/{announcerId} {
      allow read: if signedIn();
      allow create, update: if canManageSchedule() && validAnnouncerPayload();
      allow delete: if isAdmin();
    }

    function isStaff() {
      return (isActiveUser() && currentRole() != 'public') || request.auth.token.email == 'sblfm2025@gmail.com' || request.auth.token.email == 'sablfm2025@gmail.com';
    }

    match /attendanceRecords/{recordId} {
      allow read: if isLeader() || isOwner(resource.data.userId);
      allow create: if (isOwner(request.resource.data.userId) && isStaff() || isAdmin()) && validAttendancePayload();
      allow update: if (
        (isLeader() && validAttendancePayload())
        || (
          isOwner(resource.data.userId)
          && request.resource.data.userId == resource.data.userId
          && isStaff()
          && validAttendancePayload()
          && changedOnly([
            'checkOutAt',
            'selfieDriveFileId',
            'selfieUploadStatus',
            'selfieUploadError',
            'updatedAt'
          ])
        )
      );
      allow delete: if isAdmin();
    }

    match /broadcastPrograms/{programId} {
      allow read: if signedIn();
      allow create, update: if canManageSchedule()
        && request.resource.data.id == programId
        && validProgramPayload();
      allow delete: if isAdmin();
    }

    match /broadcastSchedules/{scheduleId} {
      allow read: if signedIn();
      allow create, update: if canManageSchedule()
        && request.resource.data.id == scheduleId
        && validSchedulePayload();
      allow delete: if isAdmin();
    }

    match /customScheduleSlots/{slotId} {
      allow read: if signedIn();
      allow create, update: if (canManageSchedule() || isRole(['announcer'])) && validCustomScheduleSlotPayload();
      allow delete: if isAdmin();
    }

    match /scheduleOverrides/{overrideId} {
      allow read: if signedIn();
      allow create: if validScheduleOverridePayload()
        && (canManageSchedule() || canCreateOverrideFromPendingSwap());
      allow update: if canManageSchedule() && validScheduleOverridePayload();
      allow delete: if isAdmin();
    }

    match /schedule_swaps/{requestId} {
      allow read: if isLeader()
        || isOwner(resource.data.requesterId)
        || isOwner(resource.data.targetAnnouncerId)
        || ownsAnnouncer(resource.data.targetAnnouncerId)
        || hasAnnouncerAlias(resource.data.requesterAliases)
        || hasAnnouncerAlias(resource.data.targetAnnouncerAliases);
      allow create: if isOwner(request.resource.data.requesterId)
        && validSwapPayload()
        && request.resource.data.status == 'pending_target';
      allow update: if validSwapPayload()
        && (
          (canManageSchedule() && changedOnly(['status', 'updatedAt']))
          || (
            (isOwner(resource.data.targetAnnouncerId) || ownsAnnouncer(resource.data.targetAnnouncerId) || hasAnnouncerAlias(resource.data.targetAnnouncerAliases))
            && resource.data.status == 'pending_target'
            && request.resource.data.requesterId == resource.data.requesterId
            && request.resource.data.targetAnnouncerId == resource.data.targetAnnouncerId
            && changedOnly(['status', 'updatedAt'])
            && request.resource.data.status in ['approved', 'rejected']
          )
        );
      allow delete: if isAdmin();
    }

    match /coverageAssignments/{assignmentId} {
      allow read: if isLeader() || isRole(['reporter']);
      allow create, update: if isLeader();
      allow delete: if isAdmin();
    }

    match /coverageReports/{reportId} {
      allow read: if isLeader() || isOwner(resource.data.reporterId);
      allow create: if canManageCoverage()
        && isOwner(request.resource.data.reporterId);
      allow update: if isLeader()
        || (
          isOwner(resource.data.reporterId)
          && request.resource.data.reporterId == resource.data.reporterId
        );
      allow delete: if isAdmin();
    }

    match /liveEvents/{eventId} {
      allow read: if signedIn();
      allow create, update: if canManageLiveOb() && validLiveEventPayload();
      allow delete: if isAdmin();
    }

    match /obChecklists/{itemId} {
      allow read: if signedIn();
      allow create, update: if canManageLiveOb();
      allow delete: if isAdmin();
    }

    match /youtubeLives/{liveId} {
      allow read: if signedIn();
      allow create, update: if canManageLiveOb();
      allow delete: if isAdmin();
    }

    match /discordRooms/{roomId} {
      allow read: if signedIn();
      allow create, update: if canManageLiveOb();
      allow delete: if isAdmin();
    }

    match /streamingSettings/{settingId} {
      allow read: if true;
      allow create, update: if isAdmin() || isRole(['operator']);
      allow delete: if isSuperAdmin();
    }

    match /radiobossStatus/{statusId} {
      allow read: if canAccessRadioBossOps();
      allow write: if false;
    }

    match /radiobossNowPlaying/{nowPlayingId} {
      allow read: if canAccessRadioBossOps();
      allow write: if false;
    }

    match /radiobossGatewayHeartbeat/{gatewayId} {
      allow read: if canAccessRadioBossOps();
      allow write: if false;
    }

    match /radiobossTrackHistory/{trackId} {
      allow read: if canAccessRadioBossOps();
      allow write: if false;
    }

    match /radiobossAuditLogs/{logId} {
      allow read: if canAccessRadioBossOps();
      allow write: if false;
    }

    match /programRecordingRules/{programId} {
      allow read: if canAccessRadioBossOps();
      allow create, update: if canManageSchedule()
        && (
          request.resource.data.programId == programId
          || (
            'scheduleId' in request.resource.data
            && request.resource.data.scheduleId == programId
          )
        )
        && validProgramRecordingRulePayload();
      allow delete: if isSuperAdmin();
    }

    match /programRecordings/{recordingId} {
      allow read: if canAccessRadioBossOps();
      allow write: if false;
    }

    match /radiobossCommands/{commandId} {
      allow read: if canAccessRadioBossOps();
      allow create: if canAccessRadioBossOps()
        && validRadiobossCommandPayload();
      allow update, delete: if false;
    }

    match /listenerAnalyticsSessions/{sessionId} {
      allow read: if canReadAnalytics();
      allow create: if validListenerAnalyticsSessionPayload()
        && request.resource.data.id == sessionId;
      allow update: if validListenerAnalyticsSessionPayload()
        && request.resource.data.id == resource.data.id
        && request.resource.data.anonymousId == resource.data.anonymousId
        && request.resource.data.startedAt == resource.data.startedAt;
      allow delete: if isSuperAdmin();
    }

    match /listenerStreamingErrors/{errorId} {
      allow read: if canReadAnalytics();
      allow create: if validListenerStreamingErrorPayload();
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    match /complaints/{complaintId} {
      allow read: if canManageComplaints();
      allow create: if validComplaintPayload()
        && request.resource.data.status == 'Baru';
      allow update: if canManageComplaints() && validComplaintPayload();
      allow delete: if isAdmin();
    }

    match /songRequests/{requestId} {
      allow read: if signedIn();
      allow create: if validSongRequestPayload()
        && request.resource.data.status in ['new', 'notified'];
      allow update: if isRole(['super_admin', 'admin', 'leader', 'announcer', 'operator'])
        && validSongRequestPayload();
      allow delete: if isAdmin();
    }

    match /programScriptDrafts/{draftId} {
      allow read: if canUseAi();
      allow create: if canUseAi()
        && isOwner(request.resource.data.createdBy)
        && validProgramScriptDraftPayload();
      allow update: if canUseAi() && validProgramScriptDraftPayload();
      allow delete: if isAdmin();
    }

    match /driveFiles/{fileId} {
      allow read: if isLeader() || isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId) && validDriveFilePayload();
      allow update: if validDriveFilePayload()
        && (
          isLeader()
          || (
            isOwner(resource.data.ownerId)
            && request.resource.data.ownerId == resource.data.ownerId
            && changedOnly(['name', 'webViewLink', 'updatedAt'])
          )
        );
      allow delete: if isLeader() || isOwner(resource.data.ownerId);
    }

    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId) || isLeader();
      allow create, update, delete: if isLeader();
    }

    match /aiLogs/{logId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow create: if canUseAi()
        && isOwner(request.resource.data.userId)
        && hasOnly([
          'userId',
          'prompt',
          'response',
          'module',
          'createdAt',
          'updatedAt'
        ]);
      allow update, delete: if isAdmin();
    }

    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /appSettings/{settingId} {
      allow read: if signedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
